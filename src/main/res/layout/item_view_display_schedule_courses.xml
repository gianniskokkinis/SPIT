<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginTop="10dp"
    xmlns:tools="http://schemas.android.com/tools">


    <Button
        android:id="@+id/spectate_button"
        android:layout_width="105dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="12dp"
        android:layout_toEndOf="@+id/course_time_display"
        android:backgroundTint="#B99B6B"
        android:text="VIEW"
        android:textAlignment="center" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:id="@+id/imageview_course_thunbail"
        android:layout_marginRight="10dp"
        android:layout_centerVertical="true"
        />


    <TextView
        android:id="@+id/name_course_title"
        android:layout_width="229dp"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imageview_course_thunbail"
        android:textColor="@color/white"
        android:textSize="20dp"
        tools:text="Course_title" />

    <TextView
        android:id="@+id/course_time_display"
        android:layout_width="226dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/name_course_title"
        android:layout_toEndOf="@id/imageview_course_thunbail"
        android:fontFamily="sans-serif"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        tools:text="Subject discription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/imageview_course_thunbail"
        android:layout_marginTop="10dp"

        android:background="#0A2647"
        />

</RelativeLayout>