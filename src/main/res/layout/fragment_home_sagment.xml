<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A2647"
    tools:context=".HomeSagment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <android.support.constraint.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/element_home_1"
                    android:layout_width="153dp"
                    android:layout_height="47dp"
                    android:layout_marginStart="23dp"
                    android:layout_marginTop="46dp"
                    android:src="@drawable/homelabel"
                    app:layout_constraintBottom_toTopOf="@+id/element_home_3"
                    app:layout_constraintEnd_toStartOf="@+id/element_home_2"
                    app:layout_constraintHorizontal_bias="0.044"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <ImageView
                    android:id="@+id/element_home_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:src="@drawable/homescreenoverview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/element_home_1" />

                <TextView
                    android:id="@+id/welcomeUserString"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Right Now "
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toTopOf="@+id/elemt_home_4"
                    app:layout_constraintEnd_toStartOf="@+id/home_element_5"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/element_home_3"
                    app:layout_constraintTop_toBottomOf="@+id/WelcomeUserString" />

                <ImageView
                    android:id="@+id/elemt_home_4"
                    android:layout_width="63dp"
                    android:layout_height="70dp"
                    android:src="@drawable/baseline_book_24"
                    app:layout_constraintBottom_toBottomOf="@+id/element_home_3"
                    app:layout_constraintEnd_toEndOf="@+id/element_home_3"
                    app:layout_constraintStart_toStartOf="@+id/element_home_3"
                    app:layout_constraintTop_toTopOf="@+id/element_home_3"
                    app:layout_constraintVertical_bias="0.626" />

                <TextView
                    android:id="@+id/course_title_display_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="48dp"
                    android:fontFamily="sans-serif-black"
                    android:text="'Αραξε, δεν έχεις κάτι ακόμα"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/element_home_3"
                    app:layout_constraintEnd_toEndOf="@+id/element_home_3"
                    app:layout_constraintStart_toStartOf="@+id/element_home_3"
                    app:layout_constraintTop_toBottomOf="@+id/elemt_home_4"
                    app:layout_constraintVertical_bias="0.823" />

                <TextView
                    android:id="@+id/WelcomeUserString"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Hi, "
                    android:textColor="#000000"
                    android:textSize="48sp"
                    app:layout_constraintBottom_toBottomOf="@+id/element_home_3"
                    app:layout_constraintEnd_toStartOf="@+id/home_element_5"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/element_home_3"
                    app:layout_constraintTop_toTopOf="@+id/element_home_3"
                    app:layout_constraintVertical_bias="0.105" />

                <ImageView
                    android:id="@+id/home_element_5"
                    android:layout_width="85dp"
                    android:layout_height="79dp"
                    android:src="@drawable/baseline_person_24"
                    app:layout_constraintBottom_toTopOf="@+id/elemt_home_4"
                    app:layout_constraintEnd_toEndOf="@+id/element_home_3"
                    app:layout_constraintHorizontal_bias="0.936"
                    app:layout_constraintStart_toStartOf="@+id/element_home_3"
                    app:layout_constraintTop_toTopOf="@+id/element_home_3"
                    app:layout_constraintVertical_bias="0.166" />

                <ImageButton
                    android:id="@+id/findCourseHomeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="128dp"
                    android:background="#0A2647"
                    android:src="@drawable/homefragmentbox"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/courses_queue_today"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imageView5" />

                <ImageView
                    android:id="@+id/home_element_6"
                    android:layout_width="100dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="32dp"
                    android:src="@drawable/baseline_library_books_24"
                    app:layout_constraintEnd_toEndOf="@+id/findCourseHomeBtn"
                    app:layout_constraintStart_toStartOf="@+id/findCourseHomeBtn"
                    app:layout_constraintTop_toTopOf="@+id/findCourseHomeBtn" />

                <TextView
                    android:id="@+id/welcomeUserString8"
                    android:layout_width="125dp"
                    android:layout_height="41dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Courses"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/findCourseHomeBtn"
                    app:layout_constraintEnd_toEndOf="@+id/findCourseHomeBtn"
                    app:layout_constraintHorizontal_bias="0.569"
                    app:layout_constraintStart_toStartOf="@+id/findCourseHomeBtn"
                    app:layout_constraintTop_toBottomOf="@+id/home_element_6"
                    app:layout_constraintVertical_bias="0.0" />

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/kefalaiostats"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/element_home_3" />

                <TextView
                    android:id="@+id/kefalaio_of_course_home"
                    android:layout_width="388dp"
                    android:layout_height="58dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Δεν γνωρίζω που βρίσκεται τον έχω χάσει"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView5"
                    app:layout_constraintEnd_toEndOf="@+id/imageView5"
                    app:layout_constraintStart_toStartOf="@+id/imageView5"
                    app:layout_constraintTop_toBottomOf="@+id/imageView17"
                    app:layout_constraintVertical_bias="0.184" />

                <ImageView
                    android:id="@+id/imageView17"
                    android:layout_width="64dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="88dp"
                    android:src="@drawable/baseline_menu_book_24"
                    app:layout_constraintEnd_toEndOf="@+id/imageView5"
                    app:layout_constraintStart_toStartOf="@+id/imageView5"
                    app:layout_constraintTop_toBottomOf="@+id/element_home_3" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Info"
                    android:textColor="#000000"
                    android:textSize="48sp"
                    app:layout_constraintEnd_toEndOf="@+id/imageView5"
                    app:layout_constraintHorizontal_bias="0.071"
                    app:layout_constraintStart_toStartOf="@+id/imageView5"
                    app:layout_constraintTop_toBottomOf="@+id/element_home_3" />

                <ImageButton
                    android:id="@+id/courses_queue_today"
                    android:layout_width="197dp"
                    android:layout_height="193dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="128dp"
                    android:background="#0A2647"
                    android:src="@drawable/detailscourse"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/findCourseHomeBtn"
                    app:layout_constraintTop_toBottomOf="@+id/imageView5" />

                <ImageView
                    android:id="@+id/element_home_2"
                    android:layout_width="191dp"
                    android:layout_height="101dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/homescreenrighttop"
                    app:layout_constraintBottom_toTopOf="@+id/element_home_3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <ImageView
                    android:id="@+id/imageView9"
                    android:layout_width="118dp"
                    android:layout_height="106dp"
                    android:layout_marginTop="32dp"
                    android:src="@drawable/baseline_punch_clock_24"
                    app:layout_constraintEnd_toEndOf="@+id/courses_queue_today"
                    app:layout_constraintStart_toStartOf="@+id/courses_queue_today"
                    app:layout_constraintTop_toTopOf="@+id/courses_queue_today" />

                <TextView
                    android:id="@+id/welcomeUserString9"
                    android:layout_width="125dp"
                    android:layout_height="41dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Queue"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/courses_queue_today"
                    app:layout_constraintEnd_toEndOf="@+id/courses_queue_today"
                    app:layout_constraintStart_toStartOf="@+id/courses_queue_today"
                    app:layout_constraintTop_toBottomOf="@+id/imageView9" />

                <ImageView
                    android:id="@+id/set_status_home_screen_icon"
                    android:layout_width="76dp"
                    android:layout_height="78dp"
                    android:src="@drawable/non_active_course"
                    app:layout_constraintBottom_toTopOf="@+id/elemt_home_4"
                    app:layout_constraintEnd_toStartOf="@+id/home_element_5"
                    app:layout_constraintHorizontal_bias="0.559"
                    app:layout_constraintStart_toEndOf="@+id/WelcomeUserString"
                    app:layout_constraintTop_toTopOf="@+id/element_home_3"
                    app:layout_constraintVertical_bias="0.388" />

                <ProgressBar
                    android:id="@+id/progressbar_home"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="387dp"
                    android:layout_height="368dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.171" />

            </android.support.constraint.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>