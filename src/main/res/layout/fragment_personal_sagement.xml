<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PersonalSagement">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0A2647">

            <ImageView
                android:id="@+id/imageView11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="106dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="106dp"
                android:src="@drawable/userthumbail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/Username_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="97dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="96dp"
                android:text="Username"
                android:textColor="#E7DA8F"
                android:textSize="48sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView11" />

            <TextView
                android:id="@+id/AM_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="97dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="96dp"
                android:text="AM"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/Username_field" />

            <TextView
                android:id="@+id/Etos_Field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="97dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="96dp"
                android:text="ETOS"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.495"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/AM_field" />

            <ImageButton
                android:id="@+id/edit_profile"
                android:layout_width="175dp"
                android:layout_height="90dp"
                android:layout_marginStart="97dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="92dp"
                android:background="#0A2647"
                android:src="@drawable/editbutton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.458"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/Etos_Field" />

            <ImageButton
                android:id="@+id/edit_course"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="103dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="103dp"
                android:layout_marginBottom="29dp"
                android:background="#0A2647"
                android:src="@drawable/managecoursebutton"
                app:layout_constraintBottom_toTopOf="@+id/ta_mathimata_mu"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edit_profile" />

            <android.support.v7.widget.RecyclerView
                android:id="@+id/recyclerView_courses_queue"
                android:layout_width="406dp"
                android:layout_height="596dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ta_mathimata_mu" />

            <TextView
                android:id="@+id/ta_mathimata_mu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="146dp"
                android:layout_marginTop="29dp"
                android:layout_marginEnd="147dp"
                android:layout_marginBottom="24dp"
                android:text="Τα μαθήματα μου"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                app:layout_constraintBottom_toTopOf="@+id/recyclerView_courses_queue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edit_course" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="172dp"
                android:layout_height="170dp"
                android:src="@drawable/baseline_account_circle_24"
                app:layout_constraintBottom_toBottomOf="@+id/imageView11"
                app:layout_constraintEnd_toEndOf="@+id/imageView11"
                app:layout_constraintStart_toStartOf="@+id/imageView11"
                app:layout_constraintTop_toTopOf="@+id/imageView11" />

            <ProgressBar
                android:id="@+id/progressBar_Personal_Sagment"
                style="?android:attr/progressBarStyle"
                android:layout_width="386dp"
                android:layout_height="479dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.493"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.133" />
        </android.support.constraint.ConstraintLayout>
    </ScrollView>

</FrameLayout>